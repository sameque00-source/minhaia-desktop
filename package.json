{
  "name": "minhaia",
  "version": "0.1.0",
  "private": true,
  "description": "MinhaIA — sistema de agentes construído sobre a infraestrutura MASTER (CLAUDE-MESTRE-FINAL-SKILLS-EM-LOTES-COMPLETO), consumida somente leitura.",
  "license": "UNLICENSED",
  "author": "sameq",
  "type": "commonjs",
  "main": "desktop/main.js",
  "bin": {
    "minhaia": "bin/minhaia.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node bin/minhaia.js sync",
    "verify": "node bin/minhaia.js verify",
    "doctor": "node bin/minhaia.js doctor",
    "desktop": "electron desktop/main.js",
    "dist": "electron-builder --win",
    "smoke:dist": "node scripts/smoke-dist.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:master": "node bin/minhaia.js test-master",
    "pretest": "node bin/minhaia.js sync",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.minhaia.desktop",
    "productName": "MinhaIA",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "ui/**/*",
      "bin/**/*",
      "vendor/**/*",
      ".claude/agents/**/*",
      ".claude/skills/**/*",
      "master.manifest.json",
      "master.lock.json",
      "package.json",
      "!vendor/master/ia-avancado/orquestrador/missions",
      "!vendor/master/ia-avancado/projetos/dados",
      "!vendor/master/ia-avancado/pesquisa/dados",
      "!vendor/master/ia-avancado/memoria/dados",
      "!vendor/master/ia-avancado/agentes/logs",
      "!vendor/master/ai-orchestrator/logs",
      "!vendor/master/ai-orchestrator/config",
      "!**/.secrets/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
